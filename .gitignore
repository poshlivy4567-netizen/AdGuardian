*.tmp

# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key

# Editor and operating-system files
.vscode/
.idea/
.vs/
*.code-workspace
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# Extension packaging output (generated rulesets stay versioned)
*.crx
*.zip
dist/
build/

# Chrome unpacked-load artifacts and local agent metadata
.mimocode/
_metadata/
